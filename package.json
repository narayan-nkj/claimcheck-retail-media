{
  "name": "claimcheck",
  "version": "0.1.0",
  "description": "ClaimCheck — Deterministic evidence-backed pre-publication claim checker for retail media",
  "type": "module",
  "scripts": {
    "start": "node src/server/index.ts",
    "dev": "node src/server/index.ts",
    "test": "node --test tests/contracts/*.test.js tests/evidence/*.test.js tests/policy/*.test.js tests/audit/*.test.js tests/inference/*.test.js tests/regression/*.test.js tests/webapp/*.test.js tests/evaluation/*.test.js tests/integration/*.test.js",
    "test:contracts": "node --test tests/contracts/*.test.js",
    "test:evidence": "node --test tests/evidence/*.test.js",
    "test:policy": "node --test tests/policy/*.test.js",
    "test:audit": "node --test tests/audit/*.test.js",
    "test:inference": "node --test tests/inference/*.test.js",
    "test:regression": "node --test tests/regression/*.test.js",
    "test:webapp": "node --test tests/webapp/*.test.js",
    "test:eval": "node --test tests/evaluation/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "benchmark": "node scripts/benchmark.js",
    "benchmark:amd": "node scripts/benchmark_amd.js"
  },
  "keywords": [
    "retail-media",
    "claimcheck",
    "advertising-compliance",
    "evidence-gate"
  ],
  "author": "ClaimCheck Team",
  "license": "MIT",
  "dependencies": {
    "zod": "^4.6.7"
  }
}

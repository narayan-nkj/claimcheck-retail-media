{
  "name": "claimcheck",
  "version": "0.1.0",
  "description": "ClaimCheck — Deterministic evidence-backed pre-publication claim checker for retail media",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node --import tsx src/server/index.ts",
    "start:dist": "node dist/server/index.js",
    "dev": "tsx watch src/server/index.ts",
    "test": "node --import tsx --test tests/contracts/*.test.js tests/evidence/*.test.js tests/policy/*.test.js tests/audit/*.test.js tests/inference/*.test.js tests/regression/*.test.js tests/webapp/*.test.js tests/evaluation/*.test.js tests/integration/*.test.js",
    "test:contracts": "node --import tsx --test tests/contracts/*.test.js",
    "test:evidence": "node --import tsx --test tests/evidence/*.test.js",
    "test:policy": "node --import tsx --test tests/policy/*.test.js",
    "test:audit": "node --import tsx --test tests/audit/*.test.js",
    "test:inference": "node --import tsx --test tests/inference/*.test.js",
    "test:regression": "node --import tsx --test tests/regression/*.test.js",
    "test:webapp": "node --import tsx --test tests/webapp/*.test.js",
    "test:eval": "node --import tsx --test tests/evaluation/*.test.js",
    "test:integration": "node --import tsx --test tests/integration/*.test.js",
    "benchmark": "node --import tsx scripts/benchmark.js",
    "benchmark:fallback": "node --import tsx scripts/benchmark_fallback.js",
    "benchmark:amd": "node --import tsx scripts/benchmark_amd.js",
    "benchmark:amd:live": "node --import tsx scripts/benchmark_amd_live.js",
    "evaluate": "node --import tsx scripts/evaluate.js"
  },
  "keywords": [
    "retail-media",
    "claimcheck",
    "advertising-compliance",
    "evidence-gate"
  ],
  "author": "ClaimCheck Team",
  "license": "MIT",
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
